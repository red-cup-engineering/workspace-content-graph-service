{
  "name": "@red-cup-engineering/workspace-content-graph-service",
  "version": "0.10.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "description": "Reads observed workspace resources into an addressed graph with source-bound schema lineage and native SignCell glossary and reference readouts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/workspace-content-graph-service.git"
  },
  "license": "MIT",
  "exports": {
    ".": "./src/workspace-content-graph.mjs"
  },
  "bin": {
    "catalog-workspace-content-graph": "./scripts/catalog-workspace-content-graph.mjs"
  },
  "files": [
    "scripts",
    "src"
  ],
  "scripts": {
    "check": "node --check src/workspace-content-graph.mjs && node --check src/schema-lineage.mjs && node --check scripts/catalog-workspace-content-graph.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "semiotic": {
    "operation": "catalog-workspace-content-graph",
    "precondition": "urn:semiotic:type:ObservedWorkspaceResourceSet",
    "postcondition": "urn:semiotic:type:WorkspaceContentGraph"
  },
  "dependencies": {
    "@red-cup-engineering/signcell": "0.2.0",
    "@red-cup-engineering/json-schema-services-section": "0.5.0",
    "@red-cup-engineering/computer-content-address-engineering-services-section": "0.2.0",
    "@red-cup-engineering/computer-data-engineering-services-section": "0.2.0",
    "@red-cup-engineering/markdown-engineering-services-section": "0.5.2"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}

